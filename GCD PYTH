def cop(a,b):
    return gcd(a,b)==1
def gcd(a,b):
    while(b!=0):
        rem=a%b
        temp=b
        b=rem
        a=temp
    return a 

n=int(input("Enter any number:"))
for a in range(2,n):
    for b in range(2,n):
        for c in range(2,n):
            if c*c + b*b == a*a and cop(a,b) and cop(a,c) and cop(b,c):
                print(c,b,a)
