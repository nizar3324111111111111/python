class Solution:
    def hasCycle(self, head: Optional[ListNode]) -> bool:
        # Base case: if list is empty or has only one node, no cycle exists
        if not head or not head.next:
            return False
            
        slow = head
        fast = head.next
        
        # Move pointers until they meet or fast reaches the end
        while fast and fast.next:
            if slow == fast:
                return True
            slow = slow.next
            fast = fast.next.next
            
        return False
