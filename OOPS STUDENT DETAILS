col="hits"
class AIML:
    dept="ai"
    def set_dim(self,a,b,c,d,e):
        self.m1=a
        self.m2=b
        self.m3=c
        self.name=d
        self.dept=e
    def display(self):
        print("name:",self.name)
        print("avg marks:",(self.m1+self.m2+self.m3)//3)
        print("CLG:",col)
        print("dept:",self.dept)

